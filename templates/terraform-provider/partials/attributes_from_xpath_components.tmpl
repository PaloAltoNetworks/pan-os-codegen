{{- range .Components }}
  {{ if eq .Type "value" }}
	{{ $.Target }}.{{ .Name }} = types.StringValue(components[{{ .Idx }}])
  {{- else if eq .Type "entry" }}
{
	// Decode via the SDK's inverse of AsEntryXpath so the injection-safe
	// concat(...) form (CWE-643) round-trips correctly.
	{{ $.Target }}.{{ .Name.CamelCase }} = types.StringValue(pangoutil.EntryName(components[{{ .Idx }}]))
}
  {{- end }}
{{- end }}
